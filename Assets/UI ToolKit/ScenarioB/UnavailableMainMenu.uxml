        <ui:Label text="&lt;i&gt;ID: 0217895&lt;/i&gt;" name="UserId" class="user-id"/>
        <ui:Label text="&lt;b&gt;Hello&lt;/b&gt; &lt;i&gt;Renata&lt;/i&gt;&lt;b&gt;!&lt;/b&gt;" name="HiUser" class="hi-user"/>
        <ui:VisualElement name="Kit1Card" class="kit-card pos-1">
